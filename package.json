{
  "name": "selbstbehalt",
  "version": "1.15.2",
  "private": true,
  "description": "Self-hostable, privacy-first manager for German private health insurance (PKV).",
  "license": "Apache-2.0",
  "author": "Bastian Rang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justb81/selbstbehalt.git"
  },
  "homepage": "https://github.com/justb81/selbstbehalt#readme",
  "bugs": {
    "url": "https://github.com/justb81/selbstbehalt/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm --filter @selbstbehalt/frontend test:e2e && pnpm --filter @selbstbehalt/goae-waechter test:e2e",
    "audit": "pnpm audit --prod --audit-level high",
    "headers:check": "node scripts/check-spdx-headers.mjs",
    "docs:check": "node scripts/check-doc-refs.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "fees:build": "node scripts/build-fee-schedules.mjs",
    "fees:validate": "node scripts/validate-fee-schedules.mjs",
    "ocr:models": "node scripts/fetch-ocr-models.mjs",
    "ocr:wasm": "node scripts/copy-ort-wasm.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
