# SPDX-License-Identifier: Apache-2.0
#
# Copy to deploy/reverse-proxy/caddy/.env and adjust:
#
#     cp deploy/reverse-proxy/caddy/.env.example deploy/reverse-proxy/caddy/.env
#
# This template is committed; the `.env` you create from it is gitignored and
# may hold a DNS API token — never commit it.

# Public hostname the app is served under, e.g. pkv.example.com. Must resolve
# to this host from wherever you browse to it. Required for all three TLS
# options; under Option B a LAN name such as pkv.home.arpa is fine.
DOMAIN=

# Where Let's Encrypt sends expiry and renewal notices. Used by Options A and
# C; leave empty for Option B, which never contacts a CA.
ACME_EMAIL=

# ── Option C (DNS-01) only ───────────────────────────────────────────
# Leave both empty for Options A and B.

# The Caddyfile name of the DNS provider module compiled into the image: the
# last path element of the CADDY_DNS_MODULE build arg, e.g. `cloudflare` for
# github.com/caddy-dns/cloudflare.
CADDY_DNS_PROVIDER=

# API credential for that provider. Scope it to the single zone hosting DOMAIN
# if your provider supports that — DNS-01 only ever needs to write and delete
# `_acme-challenge` TXT records in that one zone.
DNS_API_TOKEN=
