{
  "name": "@selbstbehalt/frontend",
  "version": "1.16.0",
  "private": true,
  "description": "SvelteKit PWA for selbstbehalt (PKV Manager).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node ../../scripts/copy-ort-wasm.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@selbstbehalt/medic-invoice-check": "workspace:*",
    "@selbstbehalt/shared": "workspace:*",
    "@selbstbehalt/ui": "workspace:*",
    "bits-ui": "^2.19.0",
    "date-fns": "4.4.0",
    "idb": "^8.0.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lucide/svelte": "^1.37.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@vite-pwa/sveltekit": "1.1.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.1",
    "layerchart": "2.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
