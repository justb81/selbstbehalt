{
  "name": "@selbstbehalt/frontend",
  "version": "1.16.1",
  "private": true,
  "description": "SvelteKit PWA for selbstbehalt (PKV Manager).",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ../../scripts/copy-ort-wasm.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@selbstbehalt/medic-invoice-check": "workspace:*",
    "@selbstbehalt/shared": "workspace:*",
    "@selbstbehalt/ui": "workspace:*",
    "bits-ui": "^2.20.2",
    "date-fns": "4.4.0",
    "idb": "^8.0.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lucide/svelte": "^1.66.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@vite-pwa/sveltekit": "2.0.0",
    "@vite-pwa/workbox-window": "8.0.14",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "layerchart": "2.9.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
