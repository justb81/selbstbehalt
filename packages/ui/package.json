{
  "name": "@selbstbehalt/ui",
  "version": "1.0.0",
  "private": true,
  "description": "The shadcn-svelte primitives shared by apps/frontend, apps/goae-waechter and @selbstbehalt/medic-invoice-check, plus the `cn()` class helper (issue #438). One vendored copy per component instead of three drifting ones; maintained with the shadcn-svelte CLI via components.json.",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "svelte": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./*": {
      "types": "./src/lib/components/ui/*/index.ts",
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6"
  }
}
